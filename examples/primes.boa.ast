[Define "numbers" (Call "range" [Constant (Number 2),Constant (Number 100)]),
 Define "primes" (ListComprehension (Variable "p") [For "p" (Variable "numbers"),If (Not (ListComprehension (Variable "m") [For "m" (Variable "numbers"),If (Operation Eq (Operation Mod (Variable "p") (Variable "m")) (Constant (Number 0))),If (Operation Less (Variable "m") (Variable "p"))]))]),
 Execute (Call "print" [Variable "primes"])]
